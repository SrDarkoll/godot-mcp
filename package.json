{
  "name": "godot-mcp-monorepo",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run check:tool-contracts && npm run build --workspace @godot-mcp/protocol && npm run build --workspace @godot-mcp/server && npm run build --workspace @srdarkx/godot-mcp",
    "test": "npm run build && npm run test --workspace @godot-mcp/protocol && npm run test --workspace @godot-mcp/server && npm run test --workspace @srdarkx/godot-mcp",
    "typecheck": "npm run build && npm run typecheck --workspace @godot-mcp/protocol && npm run typecheck --workspace @godot-mcp/server && npm run typecheck --workspace @srdarkx/godot-mcp",
    "test:integration": "npm run build && node scripts/run-integration.mjs",
    "test:integration:visual": "npm run build && node scripts/run-integration.mjs --visual",
    "test:integration:runtime": "npm run build && node scripts/run-integration.mjs --runtime",
    "test:integration:debugger": "npm run build && node scripts/run-integration.mjs --debugger",
    "check:godot": "node scripts/check-addon.mjs",
    "release:pack": "npm run build && node scripts/pack-release.mjs",
    "test:distribution": "npm run build && node scripts/smoke-release.mjs",
    "generate:tool-contracts": "node scripts/generate-tool-contracts.mjs",
    "check:tool-contracts": "node scripts/generate-tool-contracts.mjs --check",
    "check:public-package": "node scripts/check-public-package.mjs",
    "test:release-scripts": "node --test scripts/*.test.mjs",
    "release:dry-run": "npm run build && node scripts/pack-release.mjs --publish-dry-run"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
