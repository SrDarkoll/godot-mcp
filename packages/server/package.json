{
  "name": "@godot-mcp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "godot-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@godot-mcp/protocol": "0.1.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "exports": {
    "./project-lease": {
      "types": "./dist/project/project-lease.d.ts",
      "import": "./dist/project/project-lease.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./project-root": {
      "types": "./dist/project/project-root.d.ts",
      "import": "./dist/project/project-root.js"
    },
    "./project-config": {
      "types": "./dist/project/project-config.d.ts",
      "import": "./dist/project/project-config.js"
    },
    "./management": {
      "types": "./dist/management/client.d.ts",
      "import": "./dist/management/client.js"
    },
    "./sessions": {
      "types": "./dist/session/session-reader.d.ts",
      "import": "./dist/session/session-reader.js"
    },
    "./process": {
      "types": "./dist/process/run-command.d.ts",
      "import": "./dist/process/run-command.js"
    }
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "license": "MIT",
  "description": "Godot MCP server package (Windows-first pre-alpha)",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
