{
  "name": "@srdarkx/godot-mcp",
  "version": "0.5.2",
  "private": false,
  "description": "Connects AI assistants like Codex, Claude and Cursor to Godot 4 to create and edit scenes, run games, debug code and capture screenshots.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "godot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --testTimeout 20000"
  },
  "dependencies": {
    "@godot-mcp/protocol": "0.5.2",
    "@godot-mcp/server": "0.5.2",
    "@godot-mcp/godot-addon": "0.5.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "bundleDependencies": [
    "@godot-mcp/protocol",
    "@godot-mcp/server",
    "@godot-mcp/godot-addon"
  ]
}
