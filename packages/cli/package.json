{
  "name": "@srdarkx/godot-mcp",
  "version": "0.6.5",
  "private": false,
  "description": "Connects Codex, Claude, Cursor and other AI assistants to Godot 4 on Windows for 2D/3D scene editing, game execution, debugging and screenshots.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrDarkoll/godot-mcp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/SrDarkoll/godot-mcp",
  "bugs": {
    "url": "https://github.com/SrDarkoll/godot-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "godot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --testTimeout 20000"
  },
  "dependencies": {
    "@godot-mcp/godot-addon": "0.6.5",
    "@godot-mcp/protocol": "0.6.5",
    "@godot-mcp/server": "0.6.5",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "smol-toml": "^1.9.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "bundleDependencies": [
    "@godot-mcp/protocol",
    "@godot-mcp/server",
    "@godot-mcp/godot-addon",
    "@modelcontextprotocol/core",
    "@modelcontextprotocol/server",
    "smol-toml",
    "ws",
    "zod"
  ]
}
